{%- doc -%}
  Interactive "Prodotti" footer column: 4 macro-category triggers, hover/
  focus on one reveals its subcategories in a shared panel area below —
  CSS-only (:has()), no JS. Aspirazione defaults visible at rest so the
  panel area is never empty.

  Category/URL data mirrors snippets/mega-menu-content.liquid and
  snippets/mobile-nav-accordion.liquid — this theme has no shared data
  source for these lists, so all three are kept in sync by hand. Aspirazione
  and Macchine use real tag-filtered collection URLs (matching the header
  nav exactly); Caduta Pesante and Catene Trasportatori apply the same
  handleize convention as Aspirazione even though no explicit tag mapping
  was given for them, so all 4 columns behave consistently — verify those
  two collections' products are actually tagged to match before relying on
  them, since an unmatched tag just renders an empty (not broken) grid.
{%- enddoc -%}

<div class="footer-categories">
  <div class="footer-categories__triggers">
    <button
      type="button"
      class="footer-categories__trigger"
      data-target="aspirazione"
    >
      <span>Aspirazione</span>
      <svg class="footer-categories__trigger-arrow" width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M9 6l6 6-6 6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path></svg>
    </button>
    <button
      type="button"
      class="footer-categories__trigger"
      data-target="caduta-pesante"
    >
      <span>Caduta Pesante</span>
      <svg class="footer-categories__trigger-arrow" width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M9 6l6 6-6 6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path></svg>
    </button>
    <button
      type="button"
      class="footer-categories__trigger"
      data-target="catene-trasportatori"
    >
      <span>Catene e Trasportatori</span>
      <svg class="footer-categories__trigger-arrow" width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M9 6l6 6-6 6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path></svg>
    </button>
    <button
      type="button"
      class="footer-categories__trigger"
      data-target="macchine"
    >
      <span>Macchine</span>
      <svg class="footer-categories__trigger-arrow" width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M9 6l6 6-6 6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path></svg>
    </button>
  </div>

  <div class="footer-categories__panels">
    <ul
      class="footer-categories__panel"
      data-panel="aspirazione"
    >
      {%- assign sub_list = 'Tubi,Curve,Deviazioni,Innesti,Tramogge,Riduzioni,Silenziatori,Terminali,Accessori' | split: ',' -%}
      {%- for sub in sub_list -%}
        <li>
          <a href="{{ sub | handleize | prepend: '/collections/aspirazione/' }}">{{ sub }}</a>
        </li>
      {%- endfor -%}
    </ul>

    <ul
      class="footer-categories__panel"
      data-panel="caduta-pesante"
    >
      {%- assign sub_list = 'Tubi,Settori,Segmenti,Deviazioni,Ispezione,Valvole,Accessori,Falsa aria' | split: ',' -%}
      {%- for sub in sub_list -%}
        <li>
          <a href="{{ sub | handleize | prepend: '/collections/caduta-pesante/' }}">{{ sub }}</a>
        </li>
      {%- endfor -%}
    </ul>

    <ul
      class="footer-categories__panel"
      data-panel="catene-trasportatori"
    >
      {%- assign sub_list = 'Catene di trasporto,Ruote e rulli,Supporti e guide,Tenditori,Accessori' | split: ',' -%}
      {%- for sub in sub_list -%}
        <li>
          <a href="{{ sub | handleize | prepend: '/collections/catene-trasportatori/' }}">{{ sub }}</a>
        </li>
      {%- endfor -%}
    </ul>

    <ul
      class="footer-categories__panel"
      data-panel="macchine"
    >
      {%- assign sub_titles = 'Accettazione e Prepulitura,Pulitura,Decorticazione,Condizionamento,Macinazione e Setacciatura,Miscelazione e Prodotti Finiti,Stoccaggio' | split: ',' -%}
      {%- assign sub_slugs = 'accettazione-prepulitura,pulitura,decorticazione,condizionamento,macinazione-setacciatura,miscelazione-prodotti-finiti,stoccaggio' | split: ',' -%}
      {%- for sub in sub_titles -%}
        <li>
          <a href="{{ sub_slugs[forloop.index0] | prepend: '/collections/macchine/' }}">{{ sub }}</a>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</div>

{% stylesheet %}
  .footer-categories__triggers {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .footer-categories__trigger {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    width: 100%;
    text-align: left;
    background: none;
    border: none;
    padding: 4px 0;
    margin: 0;
    font-family: inherit;
    font-size: 0.84375rem;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.9);
    cursor: pointer;
    transition: color 0.15s ease;
  }

  .footer-categories__trigger:hover,
  .footer-categories__trigger:focus-visible {
    color: #3cc3b2;
  }

  .footer-categories__trigger-arrow {
    flex: none;
    transform: translateX(0);
    opacity: 0.6;
    transition: transform 0.3s cubic-bezier(0.25, 1, 0.5, 1), opacity 0.3s ease;
  }

  .footer-categories__trigger:hover .footer-categories__trigger-arrow,
  .footer-categories__trigger:focus-visible .footer-categories__trigger-arrow {
    transform: translateX(4px);
    opacity: 1;
  }

  .footer-categories__panels {
    display: grid;
    margin-top: 10px;
    padding-top: 10px;
    border-top: 1px solid rgba(255, 255, 255, 0.12);
  }

  /* All 4 panels stack in the same grid cell so swapping between them
     crossfades in place instead of jumping — display:none can't be
     transitioned, so this uses opacity/transform with a delayed
     visibility instead (immediate on the way in, deferred on the way out,
     so the outgoing panel keeps receiving pointer-events long enough to
     not stutter mid-fade but the incoming one is interactive right away). */
  .footer-categories__panel {
    grid-area: 1 / 1;
    display: flex;
    flex-direction: column;
    gap: 0;
    margin: 0;
    padding: 0;
    list-style: none;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transform: translateY(-4px);
    transition: opacity 0.25s ease, transform 0.25s ease, visibility 0s linear 0.25s;
  }

  .footer-categories__panel a {
    display: block;
    padding: 3px 0;
    color: rgba(255, 255, 255, 0.68);
    font-size: 0.8125rem;
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .footer-categories__panel a:hover {
    color: #3cc3b2;
  }

  /* Active-panel state shared by all 5 rules below: fades/slides in and
     becomes interactive immediately (visibility switches with no delay
     when appearing), fades/slides out on its way back to the inactive
     state above (visibility stays 'visible' for the full 0.25s transition
     so the crossfade with the incoming panel doesn't pop). */
  .footer-categories:not(:has(.footer-categories__trigger:hover, .footer-categories__trigger:focus-visible))
    .footer-categories__panel[data-panel='aspirazione'],
  .footer-categories:has(.footer-categories__trigger[data-target='aspirazione']:hover)
    .footer-categories__panel[data-panel='aspirazione'],
  .footer-categories:has(.footer-categories__trigger[data-target='aspirazione']:focus-visible)
    .footer-categories__panel[data-panel='aspirazione'],
  .footer-categories:has(.footer-categories__trigger[data-target='caduta-pesante']:hover)
    .footer-categories__panel[data-panel='caduta-pesante'],
  .footer-categories:has(.footer-categories__trigger[data-target='caduta-pesante']:focus-visible)
    .footer-categories__panel[data-panel='caduta-pesante'],
  .footer-categories:has(.footer-categories__trigger[data-target='catene-trasportatori']:hover)
    .footer-categories__panel[data-panel='catene-trasportatori'],
  .footer-categories:has(.footer-categories__trigger[data-target='catene-trasportatori']:focus-visible)
    .footer-categories__panel[data-panel='catene-trasportatori'],
  .footer-categories:has(.footer-categories__trigger[data-target='macchine']:hover)
    .footer-categories__panel[data-panel='macchine'],
  .footer-categories:has(.footer-categories__trigger[data-target='macchine']:focus-visible)
    .footer-categories__panel[data-panel='macchine'] {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: translateY(0);
    transition: opacity 0.25s ease, transform 0.25s ease;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Footer product categories",
  "tag": null
}
{% endschema %}
