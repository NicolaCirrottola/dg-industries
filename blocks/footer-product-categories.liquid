{%- doc -%}
  Interactive "Prodotti" footer column. Rest state shows ONLY the 4 macro-
  category triggers (each with a '>' marker). Hovering one instantly hides
  that whole list and fades in only its own subcategories; moving the
  mouse off the component instantly restores the rest state.

  This needs actual JS (footer-categories custom element below), not a
  pure :has()-driven swap: the moment a hovered trigger has to disappear so
  the newly-revealed subcategory links can be clicked in that same spot, it
  loses pointer-events and therefore its own :hover — which is exactly the
  condition a CSS-only :has() rule would depend on, so it self-cancels and
  flickers. JS sets an explicit data-active attribute instead, which does
  not have that problem.

  Category/URL data mirrors snippets/mega-menu-content.liquid and
  snippets/mobile-nav-accordion.liquid — this theme has no shared data
  source for these lists, so all three are kept in sync by hand. Aspirazione
  and Macchine use real tag-filtered collection URLs (matching the header
  nav exactly); Caduta Pesante and Catene Trasportatori apply the same
  handleize convention as Aspirazione even though no explicit tag mapping
  was given for them, so all 4 columns behave consistently — verify those
  two collections' products are actually tagged to match before relying on
  them, since an unmatched tag just renders an empty (not broken) grid.
{%- enddoc -%}

<footer-categories class="footer-categories">
  <div class="footer-categories__triggers">
    <button
      type="button"
      class="footer-categories__trigger"
      data-target="aspirazione"
    >
      <span>Aspirazione</span>
      <span
        class="footer-categories__trigger-arrow"
        aria-hidden="true"
        >&gt;</span
      >
    </button>
    <button
      type="button"
      class="footer-categories__trigger"
      data-target="caduta-pesante"
    >
      <span>Caduta Pesante</span>
      <span
        class="footer-categories__trigger-arrow"
        aria-hidden="true"
        >&gt;</span
      >
    </button>
    <button
      type="button"
      class="footer-categories__trigger"
      data-target="catene-trasportatori"
    >
      <span>Catene e Trasportatori</span>
      <span
        class="footer-categories__trigger-arrow"
        aria-hidden="true"
        >&gt;</span
      >
    </button>
    <button
      type="button"
      class="footer-categories__trigger"
      data-target="macchine"
    >
      <span>Macchine</span>
      <span
        class="footer-categories__trigger-arrow"
        aria-hidden="true"
        >&gt;</span
      >
    </button>
  </div>

  <div class="footer-categories__panels">
    <ul
      class="footer-categories__panel"
      data-panel="aspirazione"
    >
      {%- assign sub_list = 'Tubi,Curve,Deviazioni,Innesti,Tramogge,Riduzioni,Silenziatori,Terminali,Accessori' | split: ',' -%}
      {%- for sub in sub_list -%}
        <li>
          <a href="{{ sub | handleize | prepend: '/collections/aspirazione/' }}">{{ sub }}</a>
        </li>
      {%- endfor -%}
    </ul>

    <ul
      class="footer-categories__panel"
      data-panel="caduta-pesante"
    >
      {%- assign sub_list = 'Tubi,Settori,Segmenti,Deviazioni,Ispezione,Valvole,Accessori,Falsa aria' | split: ',' -%}
      {%- for sub in sub_list -%}
        <li>
          <a href="{{ sub | handleize | prepend: '/collections/caduta-pesante/' }}">{{ sub }}</a>
        </li>
      {%- endfor -%}
    </ul>

    <ul
      class="footer-categories__panel"
      data-panel="catene-trasportatori"
    >
      {%- assign sub_list = 'Catene di trasporto,Ruote e rulli,Supporti e guide,Tenditori,Accessori' | split: ',' -%}
      {%- for sub in sub_list -%}
        <li>
          <a href="{{ sub | handleize | prepend: '/collections/catene-trasportatori/' }}">{{ sub }}</a>
        </li>
      {%- endfor -%}
    </ul>

    <ul
      class="footer-categories__panel"
      data-panel="macchine"
    >
      {%- assign sub_titles = 'Accettazione e Prepulitura,Pulitura,Decorticazione,Condizionamento,Macinazione e Setacciatura,Miscelazione e Prodotti Finiti,Stoccaggio' | split: ',' -%}
      {%- assign sub_slugs = 'accettazione-prepulitura,pulitura,decorticazione,condizionamento,macinazione-setacciatura,miscelazione-prodotti-finiti,stoccaggio' | split: ',' -%}
      {%- for sub in sub_titles -%}
        <li>
          <a href="{{ sub_slugs[forloop.index0] | prepend: '/collections/macchine/' }}">{{ sub }}</a>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</footer-categories>

{% stylesheet %}
  .footer-categories {
    position: relative;
    z-index: 0;
    display: grid;
    overflow: visible;
    pointer-events: auto;
  }

  /* Triggers and panels share the same grid cell so the swap between them
     never changes the component's own box size — which is what keeps
     pointerleave on <footer-categories> itself from firing prematurely
     mid-swap, and avoids any layout jump/overlap while doing it. */
  .footer-categories__triggers,
  .footer-categories__panels {
    grid-area: 1 / 1;
  }

  .footer-categories__triggers {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  /* Rest state: only the trigger list. Hiding it is deliberately instant
     (no transition) — only the incoming subcategory panel fades in.

     visibility: hidden here, NOT display: none — display: none on the
     element the pointer is currently over (the trigger that was just
     entered) yanks it out of the box tree mid-hover. Several browsers
     respond to that by immediately recomputing hit-testing and firing a
     pointerleave up the ancestor chain, which hit our own listener on
     <footer-categories> and instantly cancelled the data-active state we'd
     just set — the hover trigger never "stuck". visibility: hidden keeps
     the trigger's box (and the ancestor chain under the cursor) intact, so
     no spurious pointerleave fires. */
  .footer-categories[data-active] .footer-categories__triggers {
    visibility: hidden;
    pointer-events: none;
  }

  .footer-categories__trigger {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    width: 100%;
    text-align: left;
    background: none;
    border: none;
    padding: 4px 0;
    margin: 0;
    font-family: inherit;
    font-size: 0.84375rem;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.9);
    cursor: pointer;
    transition: color 0.15s ease;
  }

  .footer-categories__trigger:hover,
  .footer-categories__trigger:focus-visible {
    color: #3cc3b2;
  }

  .footer-categories__trigger-arrow {
    flex: none;
    transform: translateX(0);
    opacity: 0.6;
    transition: transform 0.3s cubic-bezier(0.25, 1, 0.5, 1), opacity 0.3s ease;
  }

  .footer-categories__trigger:hover .footer-categories__trigger-arrow,
  .footer-categories__trigger:focus-visible .footer-categories__trigger-arrow {
    transform: translateX(4px);
    opacity: 1;
  }

  .footer-categories__panels {
    display: grid;
  }

  /* All 4 panels also stack in the same grid cell as their shared parent.
     Hidden (and non-interactive) by default; no transition here either —
     it lives only on the [data-active] rule below, so hiding stays
     instant while showing fades in. */
  .footer-categories__panel {
    grid-area: 1 / 1;
    display: flex;
    flex-direction: column;
    gap: 0;
    margin: 0;
    padding: 0;
    list-style: none;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }

  .footer-categories__panel a {
    display: block;
    padding: 3px 0;
    color: rgba(255, 255, 255, 0.68);
    font-size: 0.8125rem;
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .footer-categories__panel a:hover {
    color: #3cc3b2;
  }

  .footer-categories[data-active='aspirazione'] .footer-categories__panel[data-panel='aspirazione'],
  .footer-categories[data-active='caduta-pesante'] .footer-categories__panel[data-panel='caduta-pesante'],
  .footer-categories[data-active='catene-trasportatori']
    .footer-categories__panel[data-panel='catene-trasportatori'],
  .footer-categories[data-active='macchine'] .footer-categories__panel[data-panel='macchine'] {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transition: opacity 0.25s ease;
  }
{% endstylesheet %}

{% javascript %}
  if (!customElements.get('footer-categories')) {
    customElements.define(
      'footer-categories',
      class extends HTMLElement {
        connectedCallback() {
          this.handlePointerOver = this.handlePointerOver.bind(this);
          this.handleFocusIn = this.handleFocusIn.bind(this);
          this.handleLeave = this.handleLeave.bind(this);
          this.handleFocusOut = this.handleFocusOut.bind(this);

          // Delegated on <footer-categories> itself (which never changes
          // visibility/pointer-events) rather than bound directly on each
          // trigger button. Binding pointerenter straight onto a trigger
          // that becomes visibility: hidden / pointer-events: none the
          // instant that same handler runs is exactly the kind of setup
          // some browsers can flush a stray pointerleave/pointerout for —
          // delegating on the stable ancestor with bubbling pointerover/
          // focusin sidesteps that whole class of problem, since the event
          // that decides which panel to show has already finished before
          // any style changes happen.
          this.addEventListener('pointerover', this.handlePointerOver);
          this.addEventListener('focusin', this.handleFocusIn);
          this.addEventListener('pointerleave', this.handleLeave);
          this.addEventListener('focusout', this.handleFocusOut);
        }

        disconnectedCallback() {
          this.removeEventListener('pointerover', this.handlePointerOver);
          this.removeEventListener('focusin', this.handleFocusIn);
          this.removeEventListener('pointerleave', this.handleLeave);
          this.removeEventListener('focusout', this.handleFocusOut);
        }

        handlePointerOver(event) {
          const trigger = event.target.closest('.footer-categories__trigger');
          if (trigger) this.setAttribute('data-active', trigger.dataset.target);
        }

        handleFocusIn(event) {
          const trigger = event.target.closest('.footer-categories__trigger');
          if (trigger) this.setAttribute('data-active', trigger.dataset.target);
        }

        handleLeave() {
          this.removeAttribute('data-active');
        }

        handleFocusOut(event) {
          if (!this.contains(event.relatedTarget)) this.handleLeave();
        }
      }
    );
  }
{% endjavascript %}

{% schema %}
{
  "name": "Footer product categories",
  "tag": null
}
{% endschema %}
