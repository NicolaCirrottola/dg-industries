
{% render 'product-media-gallery-content',
  media_presentation: block.settings.media_presentation,
  block_settings: block.settings,
  block_id: block.id,
  block_shopify_attributes: block.shopify_attributes,
  block: block,
  section: section
%}

{% if block.settings.show_quick_specs %}
  {% liquid
    assign quick_specs_product = closest.product
    assign quick_specs_variant = quick_specs_product.selected_or_first_available_variant
  %}
  <product-quick-specs
    class="quick-specs"
    data-block-id="{{ block.id }}"
    data-product-id="{{ quick_specs_product.id }}"
  >
    <script
      src="{{ 'product-quick-specs.js' | asset_url }}"
      type="module"
    ></script>
    <div
      class="quick-specs__grid"
      ref="specsContainer"
    >
      <div class="quick-specs__row quick-specs__row--full">
        <span class="quick-specs__label">Cod. articolo</span>
        <span class="quick-specs__value">{{ quick_specs_variant.sku }}</span>
      </div>
      {%- for product_option in quick_specs_product.options_with_values -%}
        <div class="quick-specs__row">
          <span class="quick-specs__label">{{ product_option.name | escape }}</span>
          <span class="quick-specs__value">{{ quick_specs_variant.options[forloop.index0] }}</span>
        </div>
      {%- endfor -%}
      {%- if block.settings.quick_specs_extra_label_1 != blank -%}
        <div class="quick-specs__row">
          <span class="quick-specs__label">{{ block.settings.quick_specs_extra_label_1 | escape }}</span>
          <span class="quick-specs__value">{{ block.settings.quick_specs_extra_value_1 | escape }}</span>
        </div>
      {%- endif -%}
      {%- if block.settings.quick_specs_extra_label_2 != blank -%}
        <div class="quick-specs__row">
          <span class="quick-specs__label">{{ block.settings.quick_specs_extra_label_2 | escape }}</span>
          <span class="quick-specs__value">{{ block.settings.quick_specs_extra_value_2 | escape }}</span>
        </div>
      {%- endif -%}
    </div>
  </product-quick-specs>
{% endif %}

{% stylesheet %}
  /* Constrained square gallery panel (Valvola Butterfly reference design) */
  .product-information .media-gallery__grid {
    border: 1px solid #e6e5e2;
    background: #fafaf9;
    padding: 28px;
    max-width: 420px;
    margin: 0 auto;
    aspect-ratio: 1 / 1;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .product-information .media-gallery__grid img {
    object-fit: contain !important;
  }

  .quick-specs {
    display: block;
    margin-top: 20px;
  }

  .quick-specs__grid {
    border: 1px solid #e6e5e2;
    padding: 24px 28px;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 12px 24px;
  }

  .quick-specs__row {
    display: flex;
    justify-content: space-between;
    border-bottom: 1px solid #eeece8;
    padding-bottom: 6px;
  }

  .quick-specs__row--full {
    grid-column: 1 / -1;
  }

  .quick-specs__label {
    font-size: 11px;
    color: #2e7d32;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    font-weight: 700;
  }

  .quick-specs__value {
    font-size: 13px;
    font-weight: 600;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.product_media",
  "tag": null,
  "settings": [
    {
      "type": "select",
      "id": "media_presentation",
      "label": "t:settings.type",
      "options": [
        {
          "value": "grid",
          "label": "t:options.grid"
        },
        {
          "value": "carousel",
          "label": "t:options.carousel"
        }
      ],
      "default": "grid",
      "info": "t:info.carousel_layout_on_mobile"
    },
    {
      "type": "header",
      "content": "t:content.grid",
      "visible_if": "{{ block.settings.media_presentation == 'grid' }}"
    },
    {
      "type": "select",
      "id": "media_columns",
      "label": "t:settings.columns",
      "options": [
        {
          "value": "one",
          "label": "t:options.one_number"
        },
        {
          "value": "two",
          "label": "t:options.two_number"
        }
      ],
      "default": "one",
      "visible_if": "{{ block.settings.media_presentation == 'grid' }}"
    },
    {
      "type": "range",
      "id": "image_gap",
      "label": "t:settings.gap",
      "min": 0,
      "max": 100,
      "unit": "px",
      "step": 1,
      "default": 0,
      "visible_if": "{{ block.settings.media_presentation == 'grid' }}"
    },
    {
      "type": "checkbox",
      "id": "large_first_image",
      "label": "t:settings.full_width_first_image",
      "default": false,
      "visible_if": "{{ block.settings.media_presentation == 'grid' and block.settings.media_columns == 'two' }}"
    },
    {
      "type": "header",
      "content": "t:content.carousel"
    },
    {
      "type": "select",
      "id": "icons_style",
      "label": "t:settings.icons",
      "options": [
        {
          "value": "arrow",
          "label": "t:options.arrows"
        },
        {
          "value": "chevron",
          "label": "t:options.chevrons"
        },
        {
          "value": "arrows_large",
          "label": "t:options.large_arrows"
        },
        {
          "value": "chevron_large",
          "label": "t:options.large_chevrons"
        }
      ],
      "default": "arrow",
      "visible_if": "{{ block.settings.media_presentation == 'carousel' }}"
    },
    {
      "type": "select",
      "id": "slideshow_controls_style",
      "label": "t:settings.desktop_pagination",
      "options": [
        {
          "value": "dots",
          "label": "t:options.dots"
        },
        {
          "value": "counter",
          "label": "t:options.counter"
        },
        {
          "value": "thumbnails",
          "label": "t:options.thumbnails"
        }
      ],
      "visible_if": "{{ block.settings.media_presentation == 'carousel' }}"
    },
    {
      "type": "select",
      "id": "slideshow_mobile_controls_style",
      "label": "t:settings.mobile_pagination",
      "options": [
        {
          "value": "dots",
          "label": "t:options.dots"
        },
        {
          "value": "counter",
          "label": "t:options.counter"
        },
        {
          "value": "hint",
          "label": "t:options.hint"
        },
        {
          "value": "thumbnails",
          "label": "t:options.thumbnails"
        }
      ]
    },
    {
      "type": "header",
      "content": "t:content.thumbnails",
      "visible_if": "{{ block.settings.slideshow_controls_style == 'thumbnails' or block.settings.slideshow_mobile_controls_style == 'thumbnails' }}"
    },
    {
      "type": "select",
      "id": "thumbnail_position",
      "label": "t:settings.desktop_position",
      "options": [
        {
          "value": "left",
          "label": "t:options.left"
        },
        {
          "value": "bottom",
          "label": "t:options.bottom"
        },
        {
          "value": "right",
          "label": "t:options.right"
        }
      ],
      "default": "bottom",
      "visible_if": "{{ block.settings.slideshow_controls_style == 'thumbnails' }}"
    },
    {
      "type": "range",
      "id": "thumbnail_width",
      "label": "t:settings.width_desktop",
      "min": 44,
      "max": 72,
      "step": 1,
      "unit": "px",
      "default": 64,
      "visible_if": "{{ block.settings.slideshow_controls_style == 'thumbnails' }}"
    },
    {
      "type": "range",
      "id": "thumbnail_radius",
      "label": "t:settings.corner_radius",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.slideshow_controls_style == 'thumbnails' or block.settings.slideshow_mobile_controls_style == 'thumbnails' }}"
    },
    {
      "type": "header",
      "content": "t:content.media"
    },
    {
      "type": "select",
      "id": "aspect_ratio",
      "label": "t:settings.aspect_ratio",
      "options": [
        {
          "value": "adapt",
          "label": "t:options.auto"
        },
        {
          "value": "1/1.25",
          "label": "t:options.portrait"
        },
        {
          "value": "1",
          "label": "t:options.square"
        },
        {
          "value": "2/1",
          "label": "t:options.landscape"
        }
      ],
      "default": "adapt"
    },
    {
      "type": "checkbox",
      "id": "constrain_to_viewport",
      "label": "t:settings.limit_media_to_screen_height",
      "default": false
    },
    {
      "type": "select",
      "id": "media_fit",
      "label": "t:settings.media_fit",
      "options": [
        {
          "value": "cover",
          "label": "t:options.cover"
        },
        {
          "value": "contain",
          "label": "t:options.contain"
        }
      ],
      "default": "cover",
      "visible_if": "{{ block.settings.aspect_ratio == 'adapt' and block.settings.constrain_to_viewport == true }}"
    },
    {
      "type": "range",
      "id": "media_radius",
      "label": "t:settings.border_radius",
      "min": 0,
      "max": 32,
      "step": 1,
      "unit": "px",
      "default": 4
    },
    {
      "type": "checkbox",
      "id": "extend_media",
      "label": "t:settings.extend_media_to_screen_edge",
      "default": true,
      "visible_if": "{{ section.settings.content_width == 'content-center-aligned' }}"
    },
    {
      "type": "checkbox",
      "id": "zoom",
      "label": "t:settings.enable_zoom",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "video_loop",
      "label": "t:settings.enable_video_looping",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "hide_variants",
      "default": false,
      "label": "t:settings.hide_unselected_variant_media"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "t:settings.left",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "t:settings.right",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "Quick specs"
    },
    {
      "type": "checkbox",
      "id": "show_quick_specs",
      "label": "Show quick specs box",
      "default": false,
      "info": "Displays a 2-column box below the gallery with each product option (e.g. Diametro, Materiale) and its currently selected value."
    },
    {
      "type": "text",
      "id": "quick_specs_extra_label_1",
      "label": "Extra row 1 label",
      "info": "For facts that aren't modeled as a product option, e.g. PN"
    },
    {
      "type": "text",
      "id": "quick_specs_extra_value_1",
      "label": "Extra row 1 value",
      "info": "e.g. PN10"
    },
    {
      "type": "text",
      "id": "quick_specs_extra_label_2",
      "label": "Extra row 2 label"
    },
    {
      "type": "text",
      "id": "quick_specs_extra_value_2",
      "label": "Extra row 2 value"
    }
  ],
  "presets": [
    {
      "name": "t:names.product_media"
    }
  ]
}
{% endschema %}
