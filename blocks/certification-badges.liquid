{% liquid
  assign block_settings = block.settings
%}

<div class="certification-badges spacing-style" {{ block.shopify_attributes }}>
  {% if block_settings.heading != blank %}
    <div class="certification-badges__heading">{{ block_settings.heading }}</div>
  {% endif %}
  {% if block_settings.description != blank %}
    <p class="certification-badges__description">{{ block_settings.description }}</p>
  {% endif %}

  <div class="certification-badges__grid">
    {% if block_settings.show_tuv %}
      <div class="certification-badges__item">
        <img
          src="{{ 'dg-certification-logo-tuv-sud.svg' | asset_url }}"
          alt="TÜV SÜD"
          loading="lazy"
          width="40"
          height="40"
          style="max-height: 40px; width: auto; display: block;"
        >
        <span class="certification-badges__caption">{{ block_settings.tuv_caption | newline_to_br }}</span>
      </div>
    {% endif %}

    {% if block_settings.show_dekra %}
      <div class="certification-badges__item">
        <img
          src="{{ 'dg-certification-logo-dekra.svg' | asset_url }}"
          alt="DEKRA"
          loading="lazy"
          width="96"
          height="26"
          style="max-height: 26px; width: auto; display: block; filter: brightness(0) invert(1);"
        >
        <span class="certification-badges__caption">{{ block_settings.dekra_caption | newline_to_br }}</span>
      </div>
    {% endif %}

    {% if block_settings.show_icim %}
      <div class="certification-badges__item certification-badges__item--full">
        <img
          src="{{ 'dg-certification-logo-moca.png' | asset_url }}"
          alt="ICIM M.O.C.A."
          loading="lazy"
          width="69"
          height="52"
          style="max-height: 52px; width: auto; display: block;"
        >
        <span class="certification-badges__caption">{{ block_settings.icim_caption | newline_to_br }}</span>
      </div>
    {% endif %}
  </div>
</div>

{% stylesheet %}
  .certification-badges__heading {
    color: #ffffff;
    font-size: 12.5px;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    margin-bottom: 14px;
  }

  .certification-badges__description {
    color: rgba(255, 255, 255, 0.62);
    font-size: 12.5px;
    line-height: 1.6;
    margin: 0 0 18px;
  }

  .certification-badges__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 14px;
  }

  .certification-badges__item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    text-align: center;
  }

  .certification-badges__item--full {
    grid-column: 1 / -1;
  }

  .certification-badges__caption {
    color: rgba(255, 255, 255, 0.55);
    font-size: 9px;
    line-height: 1.4;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Certification badges",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Certificazioni"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "La DG Industries investe ogni giorno in qualità e ambiente attraverso le certificazioni del sistema di gestione."
    },
    {
      "type": "header",
      "content": "TÜV SÜD"
    },
    {
      "type": "checkbox",
      "id": "show_tuv",
      "label": "Show TÜV SÜD badge",
      "default": true
    },
    {
      "type": "textarea",
      "id": "tuv_caption",
      "label": "Caption",
      "default": "Certified Company\nUNI EN ISO 9001\nUNI EN ISO 14001"
    },
    {
      "type": "header",
      "content": "DEKRA"
    },
    {
      "type": "checkbox",
      "id": "show_dekra",
      "label": "Show DEKRA badge",
      "default": true
    },
    {
      "type": "textarea",
      "id": "dekra_caption",
      "label": "Caption",
      "default": "Certified Company\nUNI EN ISO 1090-1\nUNI EN ISO 3834-2"
    },
    {
      "type": "header",
      "content": "ICIM M.O.C.A."
    },
    {
      "type": "checkbox",
      "id": "show_icim",
      "label": "Show ICIM M.O.C.A. badge",
      "default": true
    },
    {
      "type": "textarea",
      "id": "icim_caption",
      "label": "Caption",
      "default": "Materiali a contatto con alimenti"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Certification badges",
      "category": "t:categories.footer"
    }
  ]
}
{% endschema %}
