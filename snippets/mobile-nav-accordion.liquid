{%- doc -%}
  Bespoke mobile drawer nav for the custom black-bar header's custom_columns
  menu style (dg-homepage reference design). The real Admin Navigation menu
  is never configured for this design (see blocks/_header-menu.liquid and
  snippets/mega-menu-content.liquid), so header-drawer.liquid's default
  linklist-driven <ul> would render completely empty on mobile — this
  hardcodes the same 4 macro-categories/sub-categories instead, reusing the
  native menu-drawer__* classes so it inherits the drawer's existing
  open/close chrome, fonts, and animation for free.
{%- enddoc -%}

<ul
  class="menu-drawer__menu has-submenu"
  role="list"
>
  {%- assign custom_nav_titles = 'Aspirazione,Caduta Pesante,Catene Trasportatori,Macchine' | split: ',' -%}
  {%- for nav_title in custom_nav_titles -%}
    {%- liquid
      case forloop.index
        when 1
          assign categories = 'Tubi,Curve,Deviazioni,Innesti,Tramogge,Serrande,Silenziatori,Terminali,Accessori'
        when 2
          assign categories = 'Tubi,Settori,Segmenti,Deviazioni,Ispezioni,Valvole,Accessori,Tramogge'
        when 3
          assign categories = 'Catene di trasporto,Ruote e rulli,Supporti e guide,Tenditori,Accessori'
        else
          # Mirrors snippets/mega-menu-content.liquid's Macchine (index 4)
          # branch — mill processing phases with an explicit slug list,
          # since handleize would keep the "e" in titles like "Accettazione
          # e Prepulitura" that the requested slugs drop.
          assign categories = 'Accettazione e Prepulitura,Pulitura,Decorticazione,Condizionamento,Macinazione e Setacciatura,Miscelazione e Prodotti Finiti,Stoccaggio'
          assign category_slugs = 'accettazione-prepulitura,pulitura,decorticazione,condizionamento,macinazione-setacciatura,miscelazione-prodotti-finiti,stoccaggio'
      endcase
      assign category_list = categories | split: ','
    -%}
    <li
      style="--menu-drawer-animation-index: {{ forloop.index }};"
      class="menu-drawer__list-item--deep"
    >
      <details id="Details-menu-drawer-custom-{{ forloop.index }}">
        <summary
          id="HeaderDrawer-custom-{{ forloop.index }}"
          class="menu-drawer__menu-item menu-drawer__menu-item--mainlist menu-drawer__animated-element focus-inset"
        >
          <span class="menu-drawer__menu-item-text wrap-text">{{ nav_title }}</span>
          <span class="svg-wrapper icon-plus">
            {{- 'icon-plus.svg' | inline_asset_content -}}
          </span>
        </summary>
        <ul
          class="menu-drawer__menu menu-drawer__menu--childlist menu-drawer__animated-element details-content"
          role="list"
          tabindex="-1"
        >
          {%- for cat in category_list -%}
            {%- liquid
              # Same rule as snippets/mega-menu-content.liquid: Aspirazione
              # and Caduta Pesante's subcategories (including "Deviazioni",
              # present in both lists) map onto Shopify's native collection
              # + tag filter route, each scoped to its own macro-category
              # collection so every item stays consistent with its siblings
              # in the same dropdown. Macchine uses the explicit
              # category_slugs list assigned above. Catene Trasportatori
              # isn't wired up to a specific collection's tag set yet, so
              # it keeps the '#' placeholder.
              assign cat_href = '#'
              if forloop.parentloop.index == 1
                assign cat_href = cat | handleize | prepend: '/collections/aspirazione/'
              elsif forloop.parentloop.index == 2
                assign cat_href = cat | handleize | prepend: '/collections/caduta-pesante/'
              elsif forloop.parentloop.index == 4
                assign slug_list = category_slugs | split: ','
                assign cat_href = slug_list[forloop.index0] | prepend: '/collections/macchine/'
              endif
            -%}
            <li
              class="menu-drawer__list-item"
              style="--menu-drawer-animation-index: {{ forloop.index }};"
            >
              <a
                href="{{ cat_href }}"
                class="menu-drawer__menu-item menu-drawer__menu-item--child focus-inset"
              >
                <span class="menu-drawer__menu-item-text wrap-text">{{ cat }}</span>
              </a>
            </li>
          {%- endfor -%}
        </ul>
      </details>
    </li>
  {%- endfor -%}
</ul>
