{%- doc -%}
  "Contattaci" pill button for the custom black-bar nav (dg-homepage
  reference design). Link is a block setting since there's no native
  Shopify route for a contact page — falls back to the Contact page URL
  if the theme's [contact] policy/page handle exists, otherwise "#contattaci".

  @param {string} link - The URL the button should point to.
{%- enddoc -%}

<a
  href="{{ link | default: '#contattaci' }}"
  class="header-contact-btn"
>
  <svg
    class="header-contact-btn__icon"
    width="16"
    height="16"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    aria-hidden="true"
  >
    <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
  </svg>
  <span class="header-contact-btn__label">Contattaci</span>
</a>

{% stylesheet %}
  .header-contact-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 16px;
    border-radius: 8px;
    background: rgba(60, 195, 178, 0.08);
    color: #ffffff;
    border: 1px solid rgba(60, 195, 178, 0.3);
    font-weight: 600;
    font-size: 13px;
    text-decoration: none;
    white-space: nowrap;
    flex: none;
    transition: background-color 0.2s ease, color 0.2s ease;
  }

  .header-contact-btn:hover {
    background: #3cc3b2;
    color: #000000;
  }

  .header-contact-btn__icon {
    color: #3cc3b2;
    flex: none;
    transition: color 0.2s ease;
  }

  /* Without this, the icon (color: #3cc3b2) becomes invisible against the
     hover background, which turns that same teal — swap it to match the
     label text color instead. */
  .header-contact-btn:hover .header-contact-btn__icon {
    color: #000000;
  }

  @media screen and (max-width: 1099px) {
    .header-contact-btn {
      padding: 8px 10px;
    }

    .header-contact-btn__label {
      display: none;
    }
  }
{% endstylesheet %}
