{%- doc -%}
  Persistent inline search bar for the header's right-hand actions cluster
  (dg-homepage reference design) — rendered directly by sections/header.liquid
  inside .header__actions-right, immediately to the left of the Contattaci
  button and the account/cart icons. Uses Shopify's native search
  route/params directly (routes.search_url, name="q") instead of the
  theme's icon-triggered search-modal, per explicit request to keep the bar
  always visible and significantly wider than a standard header search
  action.
{%- enddoc -%}

<form
  action="{{ routes.search_url }}"
  method="get"
  role="search"
  class="header-search-bar"
>
  <header-search-typewriter class="header-search-bar__inner">
    <svg
      class="header-search-bar__icon"
      width="15"
      height="15"
      viewBox="0 0 24 24"
      fill="none"
      aria-hidden="true"
    >
      <circle
        cx="11"
        cy="11"
        r="7"
        stroke="currentColor"
        stroke-width="1.8"
      ></circle>
      <line
        x1="21"
        y1="21"
        x2="16.65"
        y2="16.65"
        stroke="currentColor"
        stroke-width="1.8"
      ></line>
    </svg>

    <label
      for="HeaderSearchInput"
      class="visually-hidden"
    >
      {{ 'content.search_input_label' | t }}
    </label>
    <input
      type="search"
      name="q"
      id="HeaderSearchInput"
      class="header-search-bar__input"
      value="{{ search.terms | escape }}"
      autocomplete="off"
      data-typewriter-phrase="Cerca prodotti, Categorie, SKU..."
    >
    <input
      type="hidden"
      name="type"
      value="product"
    >
  </header-search-typewriter>
</form>

{% stylesheet %}
  .header-search-bar {
    /* flex-basis 560px is the bar's actual rendered width — .header__actions-
       right sizes itself to its content rather than stretching to fill the
       row, so a plain "grow to fill available space" rule would have
       nothing to grow into. flex-shrink: 1 (rather than a fixed width's
       implicit 0) lets it give way instead of overflowing/overlapping the
       Contattaci button and icons on narrower widths — max-width caps it at
       580px so shrinking never produces something wider than the basis. */
    flex: 0 1 560px;
    min-width: 0;
    max-width: 580px;
  }

  .header-search-bar__inner {
    display: flex;
    align-items: center;
    gap: 10px;
    height: 38px;
    padding: 0 14px;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.16);
    border-radius: 8px;
    transition: background 0.2s ease, border-color 0.2s ease;
  }

  .header-search-bar__inner:focus-within {
    background: rgba(255, 255, 255, 0.12);
    border-color: #3cc3b2;
  }

  .header-search-bar__icon {
    flex: none;
    color: rgba(255, 255, 255, 0.55);
  }

  .header-search-bar__input {
    width: 100%;
    min-width: 0;
    background-color: transparent !important;
    border: none !important;
    outline: none;
    color: #ffffff;
    font-family: 'Inter', sans-serif;
    font-size: 12.5px;
    font-weight: 400;
    text-align: left;
    padding-left: 16px;
    line-height: normal;
  }

  .header-search-bar__input::placeholder {
    color: rgba(255, 255, 255, 0.55);
  }

  @media screen and (max-width: 899px) {
    .header-search-bar {
      display: none;
    }
  }
{% endstylesheet %}

{% javascript %}
  // Typewriter placeholder for the persistent header search bar. Scoped
  // entirely inside this custom element — it never touches globals or other
  // search inputs (predictive search, /search page, etc.), so it can't
  // conflict with the theme's own search components.
  if (!customElements.get('header-search-typewriter')) {
    customElements.define(
      'header-search-typewriter',
      class extends HTMLElement {
        connectedCallback() {
          this.input = this.querySelector('.header-search-bar__input');
          this.phrase = this.input?.dataset.typewriterPhrase || '';
          this.charIndex = 0;
          this.deleting = false;
          this.pauseUntil = 0;

          if (this.input && this.phrase) {
            this.timer = setInterval(() => this.tick(), 70);
          }
        }

        disconnectedCallback() {
          clearInterval(this.timer);
        }

        tick() {
          if (document.activeElement === this.input || this.input.value) return;
          if (this.pauseUntil && Date.now() < this.pauseUntil) return;

          if (!this.deleting) {
            this.charIndex += 1;
            this.input.placeholder = this.phrase.slice(0, this.charIndex);

            if (this.charIndex >= this.phrase.length) {
              this.deleting = true;
              this.pauseUntil = Date.now() + 1400;
            }
          } else {
            this.charIndex -= 1;
            this.input.placeholder = this.phrase.slice(0, this.charIndex);

            if (this.charIndex <= 0) {
              this.deleting = false;
              this.pauseUntil = Date.now() + 500;
            }
          }
        }
      }
    );
  }
{% endjavascript %}
