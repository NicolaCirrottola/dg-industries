{%- doc -%}
  Product card layout styles. Kept in a standalone snippet so empty filtered grids
  can preload the styles before facets morph product cards into the section.

  @example
  {% render 'product-card-styles' %}
{%- enddoc -%}

{% stylesheet %}
  .product-grid__card.product-grid__card {
    display: flex;
    flex-flow: column nowrap;
    gap: var(--product-card-gap);
    align-items: var(--product-card-alignment);
    text-decoration: none;
    color: var(--color, var(--color-foreground));
    padding-block: var(--padding-block-start) var(--padding-block-end);
    padding-inline: var(--padding-inline-start) var(--padding-inline-end);
    overflow: hidden;
  }

  .product-grid__card .group-block > * {
    @media screen and (max-width: 749px) {
      flex-direction: column;
    }
  }

  /* Collection and product list cards have equal heights */
  :is(.product-grid__item, .resource-list__item) .product-card {
    display: grid;
    height: 100%;
  }

  /* Product card title truncation - applied on mobile regardless of view */
  @media screen and (max-width: 749px) {
    :is(.product-card, .product-grid__card) :is(h4, .h4) {
      display: -webkit-box;
      -webkit-box-orient: vertical;
      overflow: hidden;
      text-overflow: ellipsis;
      -webkit-line-clamp: 3;
    }
  }

  .product-card__placeholder-image svg {
    height: 100%;
  }

  .product-card__content slideshow-component {
    --cursor: pointer;
  }

  @media screen and (max-width: 749px) {
    .product-card slideshow-arrows .slideshow-control {
      display: none;
    }
  }

  /* ==========================================================================
     B2B card redesign — sharp/squared aesthetic, forced with !important
     regardless of any per-instance border_radius setting drifting in the
     admin later (design brief: "border-radius: 0px !important su immagini,
     card, badge e bottoni"). The per-block border_radius settings across
     every template are already 0 (see collection.json, index.json,
     product.json, cart.json, 404.json, list-collections.json, search.json)
     — this is a defensive second layer, not the primary mechanism. Scoped
     to the card/gallery/badge context only; it never touches the sitewide
     --style-border-radius-buttons variable, which also drives buttons well
     outside product cards (cart, filters, forms, etc.) and squaring those
     off wasn't part of this redesign's scope.
     ========================================================================== */
  .product-card,
  .product-card__content,
  .card-gallery,
  .card-gallery img,
  .card-gallery video,
  .product-badges__badge {
    border-radius: 0 !important;
  }

  .card-gallery .quick-add__button {
    border-radius: 0 !important;
  }

  /* Micro-text SKU line above the title — muted so it reads as secondary
     metadata rather than competing with the title/price for attention. */
  .product-sku-component {
    color: rgb(var(--color-foreground-rgb) / var(--opacity-50));
  }

  /* Micro-carousel pagination bars ("barrette") — restyled from the native
     round dots to thin squared bars, scoped to .card-gallery only so the
     main PDP gallery and other slideshow-controls usages elsewhere in the
     theme keep their normal round dots. */
  .card-gallery .slideshow-controls__dots {
    --color-active: #3cc3b2;
    gap: 4px;
    padding: 8px;
    border-radius: 0;
  }

  .card-gallery .slideshow-controls__dots button {
    width: 16px;
    height: 12px;
    margin: 0;
    border-radius: 0 !important;
  }

  .card-gallery .slideshow-controls__dots button::after {
    width: 16px;
    height: 3px;
    border-radius: 0 !important;
    box-shadow: none;
  }

  /* Dots stay hidden until the card is actually hovered/focused, matching
     the native arrows (see base.css's "Slideshow Arrow Hover Animation",
     which already reveals slideshow-arrows the same way — dots are new
     here, so the same reveal trigger is added explicitly for them). */
  .card-gallery slideshow-controls {
    opacity: 0;
    transition: opacity 0.18s ease;
  }

  .card-gallery slideshow-component:hover slideshow-controls,
  .card-gallery slideshow-component:focus-within slideshow-controls {
    opacity: 1;
  }
{% endstylesheet %}
