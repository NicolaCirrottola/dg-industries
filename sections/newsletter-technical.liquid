{% liquid
  assign s = section.settings
%}

<div class="newsletter-technical" style="{% render 'spacing-style', settings: s %}">
  <div class="newsletter-image-wrapper">
    <img
      src="{{ 'dg-newsletter.png' | asset_url }}"
      alt="Newsletter"
      loading="lazy"
      class="newsletter-right-image"
      width="1916"
      height="821"
    >
  </div>

  <div class="newsletter-technical__content-wrap">
    <div class="newsletter-technical__content">
      {% content_for 'blocks' %}
    </div>
  </div>
</div>

{% stylesheet %}
  .newsletter-technical {
    display: flex;
    align-items: stretch;
    min-height: 480px;
  }

  .newsletter-image-wrapper {
    flex: 1 1 50%;
    width: 100%;
    height: 100%;
    min-height: 100%;
    min-width: 0;
    overflow: hidden;
  }

  .newsletter-right-image,
  .newsletter-fade-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .newsletter-technical__content-wrap {
    flex: 1 1 50%;
    min-width: 0;
    display: flex;
    align-items: center;
    background-color: #ffffff;
    color: #161616;
    padding: 64px 48px;
  }

  .newsletter-technical__content {
    width: 100%;
    color: #161616;
  }

  /* Only force color on plain text elements — not inside the submit
     button, which has its own dark background and light text. */
  .newsletter-technical__content :is(h1, h2, h3, h4, p, label) {
    color: #161616;
  }

  @media screen and (max-width: 749px) {
    .newsletter-technical {
      flex-direction: column;
      min-height: 0;
    }

    .newsletter-image-wrapper {
      flex: none;
      width: 100%;
      height: 260px;
      min-height: 260px;
    }

    .newsletter-technical__content-wrap {
      padding: 40px 24px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Newsletter (technical)",
  "tag": "section",
  "blocks": [
    {
      "type": "@theme"
    },
    {
      "type": "@app"
    }
  ],
  "settings": [
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Newsletter (technical)"
    }
  ]
}
{% endschema %}
