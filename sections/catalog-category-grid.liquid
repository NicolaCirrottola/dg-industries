{% liquid
  assign section_settings = section.settings
%}

<div class="catalog-category-grid" style="{% render 'spacing-style', settings: section_settings %}">
  <div class="catalog-category-grid__inner">
    <div class="catalog-category-grid__header">
      <div>
        <div class="catalog-category-grid__eyebrow">{{ section_settings.eyebrow | escape }}</div>
        <h2 class="catalog-category-grid__heading">{{ section_settings.heading | escape }}</h2>
      </div>
      <p class="catalog-category-grid__intro">{{ section_settings.intro }}</p>
    </div>

    <div class="catalog-category-grid__grid">
      {%- for block in section.blocks -%}
        {%- liquid
          assign is_big = false
          if block.settings.size == 'big'
            assign is_big = true
          endif
        -%}
        <a
          href="{{ block.settings.link }}"
          class="catalog-category-grid__card{% if is_big %} catalog-category-grid__card--big{% endif %}"
          {{ block.shopify_attributes }}
        >
          <div class="catalog-category-grid__icon-wrap{% if is_big %} catalog-category-grid__icon-wrap--big{% endif %}">
            {%- case forloop.index -%}
              {%- when 1 -%}
                <svg width="{% if is_big %}30{% else %}24{% endif %}" height="{% if is_big %}30{% else %}24{% endif %}" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="2.2" stroke="#3cc3b2" stroke-width="1.6"></circle><path d="M12 9.8C12 6 10 3 7 3c0 3.5 2 5.6 5 6.8z" stroke="#3cc3b2" stroke-width="1.6"></path><path d="M14.2 12C18 12 21 10 21 7c-3.5 0-5.6 2-6.8 5z" stroke="#3cc3b2" stroke-width="1.6"></path><path d="M12 14.2c0 3.8 2 6.8 5 6.8 0-3.5-2-5.6-5-6.8z" stroke="#3cc3b2" stroke-width="1.6"></path><path d="M9.8 12C6 12 3 14 3 17c3.5 0 5.6-2 6.8-5z" stroke="#3cc3b2" stroke-width="1.6"></path></svg>
              {%- when 2 -%}
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none"><path d="M4 15V9a5 5 0 0 1 5-5h6" stroke="#3cc3b2" stroke-width="1.6" stroke-linecap="round"></path><path d="M20 9v6a5 5 0 0 1-5 5H9" stroke="#3cc3b2" stroke-width="1.6" stroke-linecap="round"></path><circle cx="4" cy="17" r="2" stroke="#3cc3b2" stroke-width="1.6"></circle><circle cx="20" cy="7" r="2" stroke="#3cc3b2" stroke-width="1.6"></circle></svg>
              {%- when 3 -%}
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none"><rect x="3" y="9" width="7" height="6" rx="3" stroke="#3cc3b2" stroke-width="1.6"></rect><rect x="14" y="9" width="7" height="6" rx="3" stroke="#3cc3b2" stroke-width="1.6"></rect><path d="M10 12h4" stroke="#3cc3b2" stroke-width="1.6"></path></svg>
              {%- when 4 -%}
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none"><rect x="3" y="6" width="18" height="12" rx="1.5" stroke="#3cc3b2" stroke-width="1.6"></rect><circle cx="9" cy="12" r="2.4" stroke="#3cc3b2" stroke-width="1.6"></circle><path d="M14 9h4M14 12h4M14 15h4" stroke="#3cc3b2" stroke-width="1.6" stroke-linecap="round"></path></svg>
              {%- else -%}
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none"><path d="M12 2v3M12 19v3M4.2 4.2l2.1 2.1M17.7 17.7l2.1 2.1M2 12h3M19 12h3M4.2 19.8l2.1-2.1M17.7 6.3l2.1-2.1" stroke="#3cc3b2" stroke-width="1.6" stroke-linecap="round"></path><circle cx="12" cy="12" r="4.2" stroke="#3cc3b2" stroke-width="1.6"></circle></svg>
            {%- endcase -%}
          </div>
          <div>
            <div class="catalog-category-grid__card-title{% if is_big %} catalog-category-grid__card-title--big{% endif %}">{{ block.settings.title | escape }}</div>
            <div class="catalog-category-grid__card-desc">{{ block.settings.description | escape }}</div>
          </div>
          <div class="catalog-category-grid__card-arrow-row{% if is_big %} catalog-category-grid__card-arrow-row--big{% endif %}">
            {%- if is_big -%}<span>Scopri la categoria</span>{%- endif -%}
            <span class="catalog-category-grid__card-arrow">→</span>
          </div>
        </a>
      {%- endfor -%}
    </div>
  </div>
</div>

{% stylesheet %}
  .catalog-category-grid {
    background: linear-gradient(160deg, #f3f6f5, #eef5f4 60%, #eef7f5);
    padding: 90px 48px 100px;
  }

  .catalog-category-grid__inner {
    max-width: 1240px;
    margin: 0 auto;
  }

  .catalog-category-grid__header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    margin-bottom: 44px;
    flex-wrap: wrap;
    gap: 16px;
  }

  .catalog-category-grid__eyebrow {
    font-size: 11.5px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #2e7f76;
    font-weight: 700;
    margin-bottom: 10px;
  }

  .catalog-category-grid__heading {
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-weight: 700;
    font-size: 30px;
    letter-spacing: -0.01em;
    margin: 0;
    color: #161616;
  }

  .catalog-category-grid__intro {
    color: #6b6f6d;
    font-size: 13.5px;
    max-width: 38ch;
    margin: 0;
  }

  .catalog-category-grid__grid {
    display: grid;
    grid-template-columns: 1.3fr 1fr 1fr;
    grid-template-rows: repeat(2, 1fr);
    gap: 20px;
  }

  .catalog-category-grid__card {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 14px;
    padding: 26px 22px;
    border-radius: 18px;
    background: rgba(255, 255, 255, 0.55);
    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);
    border: 1px solid rgba(22, 22, 22, 0.07);
    box-shadow: 0 8px 30px rgba(30, 60, 55, 0.06);
    text-decoration: none;
    will-change: transform, opacity;
    transition: transform 0.5s cubic-bezier(0.25, 1, 0.5, 1), border-color 0.4s cubic-bezier(0.25, 1, 0.5, 1),
      box-shadow 0.4s cubic-bezier(0.25, 1, 0.5, 1), background 0.4s cubic-bezier(0.25, 1, 0.5, 1);
  }

  .catalog-category-grid__card--big {
    grid-row: 1 / 3;
    grid-column: 1;
    padding: 34px 30px;
    gap: 18px;
  }

  .catalog-category-grid__card:hover {
    transform: translateY(-4px) scale(1.02);
    border-color: rgba(60, 195, 178, 0.55);
    box-shadow: 0 16px 40px rgba(30, 60, 55, 0.12);
    background: rgba(255, 255, 255, 0.72);
  }

  .catalog-category-grid__icon-wrap {
    width: 44px;
    height: 44px;
    border-radius: 12px;
    background: rgba(60, 195, 178, 0.1);
    border: 1px solid rgba(60, 195, 178, 0.28);
    display: flex;
    align-items: center;
    justify-content: center;
    flex: none;
  }

  .catalog-category-grid__icon-wrap--big {
    width: 58px;
    height: 58px;
    border-radius: 16px;
    background: rgba(60, 195, 178, 0.12);
    border: 1px solid rgba(60, 195, 178, 0.3);
  }

  .catalog-category-grid__card-title {
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 16.5px;
    font-weight: 700;
    color: #161616;
    margin-bottom: 6px;
  }

  .catalog-category-grid__card-title--big {
    font-size: 22px;
    margin-bottom: 8px;
  }

  .catalog-category-grid__card-desc {
    font-size: 12.5px;
    color: #5c5f5d;
    line-height: 1.55;
  }

  .catalog-category-grid__card--big .catalog-category-grid__card-desc {
    font-size: 13.5px;
    line-height: 1.6;
    max-width: 30ch;
  }

  .catalog-category-grid__card-arrow-row {
    display: flex;
    justify-content: flex-end;
    color: #2e7f76;
    font-size: 14px;
  }

  .catalog-category-grid__card-arrow-row--big {
    justify-content: space-between;
    align-items: center;
    font-size: 13px;
    font-weight: 700;
  }

  .catalog-category-grid__card-arrow {
    display: inline-block;
    transition: transform 0.3s cubic-bezier(0.25, 1, 0.5, 1);
  }

  .catalog-category-grid__card:hover .catalog-category-grid__card-arrow {
    transform: translateX(4px);
  }

  @media screen and (max-width: 749px) {
    .catalog-category-grid__grid {
      grid-template-columns: 1fr;
      grid-template-rows: none;
    }

    .catalog-category-grid__card--big {
      grid-row: auto;
      grid-column: auto;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Catalog category grid",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Catalogo"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Esplora per categoria"
    },
    {
      "type": "textarea",
      "id": "intro",
      "label": "Intro text",
      "default": "Cinque aree tecniche coprono l'intero impianto: dall'aspirazione alla movimentazione pesante, fino ai servizi post-vendita."
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "category-card",
      "name": "Category card",
      "settings": [
        {
          "type": "select",
          "id": "size",
          "label": "Size",
          "options": [
            { "value": "big", "label": "Big (first card only)" },
            { "value": "small", "label": "Small" }
          ],
          "default": "small"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Categoria"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Catalog category grid",
      "blocks": [
        {
          "type": "category-card",
          "settings": {
            "size": "big",
            "title": "Sistemi di Aspirazione",
            "description": "Ventilatori, filtri e cicloni per la captazione polveri e il deumidificamento impianti."
          }
        },
        {
          "type": "category-card",
          "settings": {
            "size": "small",
            "title": "Caduta Pesante",
            "description": "Tubi, settori, segmenti e valvole per il trasporto per caduta di prodotti sfusi."
          }
        },
        {
          "type": "category-card",
          "settings": {
            "size": "small",
            "title": "Movimentazione Pesante",
            "description": "Catene, coclee e trasportatori heavy-duty."
          }
        },
        {
          "type": "category-card",
          "settings": {
            "size": "small",
            "title": "Macchine",
            "description": "Filtri, valvole, dosatori, trasportatori, decorticatrici."
          }
        },
        {
          "type": "category-card",
          "settings": {
            "size": "small",
            "title": "Servizi",
            "description": "Consulenza tecnica e assistenza post-vendita."
          }
        }
      ]
    }
  ]
}
{% endschema %}
