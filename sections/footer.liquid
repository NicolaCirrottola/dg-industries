{%- doc -%}
  Fully hardcoded, static footer — no JS, no hover/dropdown behavior.
  Deliberately not block-driven (no content_for 'blocks', no schema
  settings): nothing here is editable from the Shopify theme editor. That's
  intentional, not an oversight — flagged here so a future editor doesn't
  go looking for a "why won't this show up in the customizer" bug that
  isn't one.
{%- enddoc -%}

<footer
  style="
    width: 100%;
    max-width: 100vw;
    background-color: #000;
    color: #fff;
    padding: 3.5rem 4rem;
    box-sizing: border-box;
    overflow: hidden;
  "
>
  <div
    class="footer-grid"
    style="
      display: grid;
      grid-template-columns: 1.3fr 1fr 1fr 1fr;
      gap: 3rem;
      align-items: start;
    "
  >
    {%- comment -%} COLONNA 1 — Logo e recapiti {%- endcomment -%}
    <div>
      <img
        src="{{ 'dg-logo.png' | asset_url }}"
        alt="{{ shop.name | escape }}"
        width="66"
        height="57"
        loading="lazy"
        style="height: 34px; width: auto; object-fit: contain; display: block; margin-bottom: 18px;"
      >
      <p style="margin: 0 0 4px; font-size: 0.84375rem; font-weight: 700; color: #fff;">
        Defino &amp; Giancaspro S.r.l.
      </p>
      <p style="margin: 0 0 14px; font-size: 0.8125rem; line-height: 1.7; color: rgba(255, 255, 255, 0.75);">
        Specialisti da oltre 60 anni nella realizzazione di soluzioni avanzate per l'industria agroalimentare.
      </p>
      <p style="margin: 0; font-size: 0.8125rem; line-height: 1.7; color: rgba(255, 255, 255, 0.75);">
        Via Archimede, 27/33 – zona PIP<br>
        70024 – Gravina in Puglia (BA)<br>
        Tel.: +39 080.326.61.96<br>
        Email: <a
          href="mailto:info@defino-giancaspro.com"
          style="color: inherit;"
          >info@defino-giancaspro.com</a
        ><br>
        PEC: <a
          href="mailto:defino-giancaspro@pec.it"
          style="color: inherit;"
          >defino-giancaspro@pec.it</a
        >
      </p>
    </div>

    {%- comment -%}
      COLONNA 2 — Macrocategorie: plain direct links, no dropdown/JS.

      catene-trasportatori (no "e") confirmed as the real collection
      handle — matches every other "Catene Trasportatori" link in the
      theme (header nav in blocks/_header-menu.liquid, the mega-menu, the
      mobile drawer).
    {%- endcomment -%}
    <div>
      <div
        style="font-size: 0.78125rem; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: #fff; margin-bottom: 12px;"
      >
        Prodotti &amp; Categorie
      </div>
      <div style="display: flex; flex-direction: column; gap: 8px;">
        <a
          href="/collections/aspirazione"
          class="footer-link"
          >Aspirazione</a
        >
        <a
          href="/collections/caduta-pesante"
          class="footer-link"
          >Caduta Pesante</a
        >
        <a
          href="/collections/catene-trasportatori"
          class="footer-link"
          >Catene e Trasportatori</a
        >
        <a
          href="/collections/macchine"
          class="footer-link"
          >Macchine</a
        >
      </div>
    </div>

    {%- comment -%} COLONNA 3 — Azienda & Supporto {%- endcomment -%}
    <div>
      <div
        style="font-size: 0.78125rem; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: #fff; margin-bottom: 12px;"
      >
        Azienda &amp; Supporto
      </div>
      <div style="display: flex; flex-direction: column; gap: 8px;">
        <a
          href="#"
          class="footer-link"
          >Chi Siamo</a
        >
        <a
          href="#"
          class="footer-link"
          >Catalogo B2B (PDF)</a
        >
        <a
          href="/pages/parliamone"
          class="footer-link"
          >Richiedi Preventivo Su Misura</a
        >
        <a
          href="/pages/parliamone"
          class="footer-link"
          >Assistenza Tecnica</a
        >
        <a
          href="/pages/parliamone"
          class="footer-link"
          >Contatti</a
        >
      </div>
    </div>

    {%- comment -%} COLONNA 4 — Certificazioni {%- endcomment -%}
    <div>
      <div
        style="font-size: 0.78125rem; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: #fff; margin-bottom: 12px;"
      >
        Certificazioni
      </div>
      <p style="margin: 0 0 18px; font-size: 0.78125rem; line-height: 1.6; color: rgba(255, 255, 255, 0.62);">
        Investiamo ogni giorno in qualità e ambiente attraverso le certificazioni del sistema di gestione.
      </p>
      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 14px;">
        <div style="display: flex; flex-direction: column; align-items: center; gap: 8px; text-align: center;">
          <img
            src="{{ 'dg-certification-logo-tuv-sud.svg' | asset_url }}"
            alt="TÜV SÜD"
            width="40"
            height="40"
            loading="lazy"
            style="max-height: 40px; width: auto; display: block;"
          >
          <span style="font-size: 9px; line-height: 1.4; color: rgba(255, 255, 255, 0.55);">Certified Company<br>UNI EN ISO 9001<br>UNI EN ISO 14001</span>
        </div>
        <div style="display: flex; flex-direction: column; align-items: center; gap: 8px; text-align: center;">
          <img
            src="{{ 'dg-certification-logo-dekra.svg' | asset_url }}"
            alt="DEKRA"
            width="96"
            height="26"
            loading="lazy"
            style="max-height: 26px; width: auto; display: block; filter: brightness(0) invert(1);"
          >
          <span style="font-size: 9px; line-height: 1.4; color: rgba(255, 255, 255, 0.55);">Certified Company<br>UNI EN ISO 1090-1<br>UNI EN ISO 3834-2</span>
        </div>
        <div style="grid-column: 1 / -1; display: flex; flex-direction: column; align-items: center; gap: 8px; text-align: center;">
          <img
            src="{{ 'dg-certification-logo-moca.png' | asset_url }}"
            alt="ICIM M.O.C.A."
            width="69"
            height="52"
            loading="lazy"
            style="max-height: 52px; width: auto; display: block;"
          >
          <span style="font-size: 9px; line-height: 1.4; color: rgba(255, 255, 255, 0.55);">Materiali a contatto con alimenti</span>
        </div>
      </div>
    </div>
  </div>
</footer>

<style>
  .footer-link {
    color: rgba(255, 255, 255, 0.75);
    font-size: 0.84375rem;
    text-decoration: none;
  }

  .footer-link:hover {
    color: #3cc3b2;
  }

  @media screen and (max-width: 989px) {
    .footer-grid {
      grid-template-columns: 1fr !important;
    }
  }
</style>

{% schema %}
{
  "name": "t:names.footer",
  "class": "section-wrapper",
  "tag": "div",
  "enabled_on": {
    "groups": ["footer"]
  },
  "settings": [],
  "presets": [
    {
      "name": "t:names.footer",
      "category": "t:categories.footer"
    }
  ]
}
{% endschema %}
