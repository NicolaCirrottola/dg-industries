{% liquid
  assign s = section.settings
%}
{% capture newline %}
{% endcapture %}
{% assign heading_lines = s.heading | split: newline %}

<div
  class="hero-technical"
  style="--hero-accent: {{ s.accent_color | default: '#3cc3b2' }}; --hero-heading-color: {{ s.heading_color | default: '#161616' }};"
>
  <img
    src="{{ 'dg-placeholder.png' | asset_url }}"
    alt=""
    class="hero-technical__image"
    width="1672"
    height="941"
    loading="eager"
  >

  <div class="hero-technical__content">
    {% if s.eyebrow != blank %}
      <div class="hero-technical__eyebrow">{{ s.eyebrow | escape }}</div>
    {% endif %}

    {% if heading_lines.size > 1 %}
      <h1 class="hero-technical__heading hero-technical__heading--rotating">
        {%- for line in heading_lines -%}
          <span class="hero-technical__heading-line" style="--i: {{ forloop.index0 }};">{{ line }}</span>
        {%- endfor -%}
      </h1>
    {% else %}
      <h1 class="hero-technical__heading">{{ s.heading }}</h1>
    {% endif %}

    {% if s.subtext != blank %}
      <p class="hero-technical__subtext">{{ s.subtext }}</p>
    {% endif %}

    <div class="hero-technical__actions">
      {% if s.button_1_label != blank %}
        <a href="{{ s.button_1_link | default: '#' }}" class="hero-technical__button hero-technical__button--primary">
          {{ s.button_1_label | escape }}
        </a>
      {% endif %}
      {% if s.button_2_label != blank %}
        <a href="{{ s.button_2_link | default: '#' }}" class="hero-technical__button hero-technical__button--secondary">
          {{ s.button_2_label | escape }}
        </a>
      {% endif %}
    </div>
  </div>
</div>

{% stylesheet %}
  .hero-technical {
    position: relative;
    overflow: hidden;
    background: #fbfbfa;
    min-height: 640px;
    display: flex;
    align-items: center;
  }

  .hero-technical__image {
    position: absolute;
    right: 0;
    top: 0;
    height: 100%;
    width: 66%;
    object-fit: cover;
    -webkit-mask-image: linear-gradient(to left, rgba(0, 0, 0, 1) 30%, rgba(0, 0, 0, 0) 100%),
      linear-gradient(to top, rgba(0, 0, 0, 1) 20%, rgba(0, 0, 0, 0) 100%);
    -webkit-mask-composite: source-in;
    mask-image: linear-gradient(to left, rgba(0, 0, 0, 1) 30%, rgba(0, 0, 0, 0) 100%),
      linear-gradient(to top, rgba(0, 0, 0, 1) 20%, rgba(0, 0, 0, 0) 100%);
    mask-composite: intersect;
  }

  .hero-technical__content {
    position: relative;
    max-width: 1240px;
    width: 100%;
    margin: 0 auto;
    padding: 0 48px;
  }

  .hero-technical__content > * {
    max-width: 560px;
  }

  .hero-technical__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 14px;
    border: 1px solid rgba(22, 22, 22, 0.14);
    border-radius: 999px;
    color: var(--hero-accent, #3cc3b2);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    margin-bottom: 22px;
    background: rgba(255, 255, 255, 0.5);
  }

  .hero-technical__heading {
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-weight: 800;
    font-size: clamp(2rem, 1.5rem + 2.2vw, 2.875rem);
    line-height: 1.15;
    letter-spacing: -0.01em;
    color: var(--hero-heading-color, #161616);
    margin: 0 0 20px;
  }

  .hero-technical__heading--rotating {
    position: relative;
    min-height: 165px;
  }

  .hero-technical__heading-line {
    position: absolute;
    inset: 0;
    opacity: 0;
    animation: hero-heading-fade 20s ease-in-out infinite;
    animation-delay: calc(var(--i) * -4s);
  }

  @keyframes hero-heading-fade {
    0%,
    100% {
      opacity: 0;
    }
    1% {
      opacity: 0;
    }
    4% {
      opacity: 1;
    }
    16% {
      opacity: 1;
    }
    19% {
      opacity: 0;
    }
  }

  .hero-technical__subtext {
    color: #54544f;
    font-size: 15.5px;
    line-height: 1.7;
    margin: 0 0 32px;
    max-width: 46ch;
  }

  .hero-technical__actions {
    display: flex;
    align-items: center;
    gap: 14px;
    flex-wrap: wrap;
  }

  .hero-technical__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 52px;
    padding: 0 30px;
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 14px;
    letter-spacing: 0.02em;
    text-decoration: none;
    white-space: nowrap;
    transition: background 0.2s ease, color 0.2s ease, border-color 0.2s ease;
  }

  .hero-technical__button--primary {
    background: #161616;
    color: #ffffff;
    font-weight: 700;
    border: 1px solid #161616;
  }

  .hero-technical__button--primary:hover {
    background: var(--hero-accent, #3cc3b2);
    border-color: var(--hero-accent, #3cc3b2);
    color: #000000;
  }

  .hero-technical__button--secondary {
    background: transparent;
    color: #161616;
    font-weight: 600;
    border: 1px solid rgba(22, 22, 22, 0.22);
  }

  .hero-technical__button--secondary:hover {
    border-color: var(--hero-accent, #3cc3b2);
    color: #2e7f76;
  }

  @media screen and (max-width: 749px) {
    .hero-technical {
      min-height: auto;
      flex-direction: column;
      padding-bottom: 44px;
    }

    .hero-technical__image {
      position: relative;
      width: 100%;
      height: 280px;
      -webkit-mask-image: linear-gradient(to bottom, rgba(0, 0, 0, 1) 55%, rgba(0, 0, 0, 0.25) 82%, rgba(0, 0, 0, 0) 100%);
      mask-image: linear-gradient(to bottom, rgba(0, 0, 0, 1) 55%, rgba(0, 0, 0, 0.25) 82%, rgba(0, 0, 0, 0) 100%);
      mask-composite: normal;
      -webkit-mask-composite: source-over;
    }

    .hero-technical__content {
      margin-top: -70px;
      padding: 0 24px;
    }

    .hero-technical__content > * {
      max-width: none;
    }

    .hero-technical__heading--rotating {
      min-height: 210px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Hero (technical)",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Dal 1963 — Industria Agroalimentare"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "info": "One phrase per line. With 2+ lines, the heading rotates through them (4s each, fading in/out).",
      "default": "Soluzioni tecniche per aspirazione, trasporto e movimentazione sfusi\nValvole e tubazioni su misura per l'industria molitoria\nSistemi di aspirazione ad alta efficienza\nComponenti certificati per il contatto alimentare\nAssistenza tecnica e ricambi in tutta Italia"
    },
    {
      "type": "textarea",
      "id": "subtext",
      "label": "Subtext",
      "default": "Progettiamo e produciamo valvole, tubazioni e sistemi di aspirazione per impianti molitori, cerealicoli e di trasporto pneumatico — su misura per ogni linea di produzione."
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#161616"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent color",
      "default": "#3cc3b2"
    },
    {
      "type": "header",
      "content": "Button 1"
    },
    {
      "type": "text",
      "id": "button_1_label",
      "label": "Label",
      "default": "Esplora il catalogo"
    },
    {
      "type": "url",
      "id": "button_1_link",
      "label": "Link"
    },
    {
      "type": "header",
      "content": "Button 2"
    },
    {
      "type": "text",
      "id": "button_2_label",
      "label": "Label",
      "default": "Richiedi consulenza"
    },
    {
      "type": "url",
      "id": "button_2_link",
      "label": "Link"
    }
  ],
  "presets": [
    {
      "name": "Hero (technical)"
    }
  ]
}
{% endschema %}
